# ============================================================
#  .htaccess بهینه برای فرانت‌اند micopetfood.ir
#  نسخه ۴.۲ — رفع مشکل صفحه‌ی سفید بلاگ
#
#  ✅ این نسخه:
#    - قانون ۴۰۴ حذف شد (باگ: باعث صفحه‌ی سفید می‌شد)
#    - SPA routing اولویت پیدا کرد
#    - صفحات بلاگ، about، contact درست لود می‌شن
# ============================================================

# ------------------------------------------------------------
#  ۰. تنظیمات پایه
# ------------------------------------------------------------
DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# ============================================================
#  ۱. ریدایرکت www به non-www (جلوگیری از Duplicate Content)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================
#  ۲. ریدایرکت sitemap.xml به بک‌اند (روش 301)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteRule ^sitemap\.xml$ https://api.micopetfood.ir/sitemap.xml [R=301,L,QSA]
  RewriteRule ^robots\.txt$ https://api.micopetfood.ir/robots.txt [R=301,L,QSA]
  RewriteRule ^feed\.xml$ https://api.micopetfood.ir/feed.xml [R=301,L,QSA]
  RewriteRule ^rss\.xml$ https://api.micopetfood.ir/feed.xml [R=301,L,QSA]
</IfModule>

# ============================================================
#  ۳. نرمال‌سازی Trailing Slash
# ============================================================
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [R=301,L]
</IfModule>

# ============================================================
#  ۴. ✅ حذف قانون ۴۰۴ — این قانون باعث صفحه‌ی سفید می‌شد!
#     SPA خودش صفحه‌ی NotFound داره و 404 رو هندل می‌کنه.
#     قانون ۴۰۴ قبلی، صفحات /blog/<slug> رو قبل از لود SPA،
#     با 404 رد می‌کرد.
# ============================================================
# (این بخش عمداً حذف شده)

# ============================================================
#  ۵. هدرهای امنیتی
# ============================================================
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://api.micopetfood.ir https://micopetfood.ir; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>

# ============================================================
#  ۶. فشرده‌سازی GZIP
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

# ============================================================
#  ۷. Cache-Control
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "manifest\.json$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ============================================================
#  ۸. Charset و MIME Types
# ============================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .rss .atom

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/rss+xml .rss
  AddType application/atom+xml .atom
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# ============================================================
#  ۹. مسدود کردن فایل‌های حساس
# ============================================================
<FilesMatch "(^\.|\.bak$|\.log$|\.sql$|\.db$|\.sqlite$|\.env)">
  Require all denied
</FilesMatch>

# ============================================================
#  ۱۰. ETag
# ============================================================
FileETag MTime Size

# ============================================================
#  ۱۱. ✅ SPA Routing — مهم‌ترین بخش
#     این قانون باید آخر باشه. هر URL که فایل فیزیکی نیست
#     (مثل /blog/ghazay-khanegi-sag) رو به index.html بفرسته
#     تا React Router اون رو هندل کنه.
# ============================================================
<IfModule mod_rewrite.c>
  # اگه فایل یا پوشه واقعی هست، کاری نکن
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # فایل‌های استاتیک رو دست نزن
  RewriteCond %{REQUEST_URI} ^/static/ [OR]
  RewriteCond %{REQUEST_URI} ^/uploads/ [OR]
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/admin/
  RewriteRule ^ - [L]

  # sitemap, robots, feed رو دست نزن (قبلاً هندل شدن)
  RewriteCond %{REQUEST_URI} ^/sitemap\.xml [OR]
  RewriteCond %{REQUEST_URI} ^/robots\.txt [OR]
  RewriteCond %{REQUEST_URI} ^/feed\.xml [OR]
  RewriteCond %{REQUEST_URI} ^/rss\.xml
  RewriteRule ^ - [L]

  # فایل‌های با پسوند رو دست نزن
  RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|eot|map|json|txt|xml|webmanifest)$ [NC]
  RewriteRule ^ - [L]

  # ✅ هر چیز دیگه (شامل /blog/<slug>, /about, /contact, /panel/*, ...)
  # رو به index.html بفرست تا React Router هندل کنه
  RewriteRule . /index.html [L]
</IfModule>

# ============================================================
#  پایان
# ============================================================
